@page
@model Veterinaria.Web.Pages.Mascotas.IndexModel
@{
    ViewData["Title"] = "Mascotas";
}

<div class="container py-4">
    <!-- BLOQUE F-12: Mostrar mensaje de error si existe -->
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger border-0 shadow-sm mb-3">
            @Model.Error
        </div>
    }

    <!-- Alerta de éxito opcional (TempData) -->
    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success border-0 shadow-sm mb-3">@mensaje</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold m-0">Mascotas</h1>
            <p class="text-muted mb-0">Mascotas registradas en la clínica.</p>
        </div>

        <a asp-page="./Nueva" class="btn btn-florecitas">
            + Nueva mascota
        </a>
    </div>

    <div class="card card-florecitas p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Especie</th>
                        <th>Raza</th>
                        <th>Sexo</th>
                        <th>Propietario</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Mascotas)
                    {
                        <tr>
                            <td class="fw-bold">@item.Mascota.Nombre</td>
                            <td>@item.Mascota.Especie</td>
                            <td>@item.Mascota.Raza</td>
                            <td>@item.Mascota.Sexo</td>
                            <td>@item.Propietario</td>
                            <td class="text-end">
                                <a asp-page="./Detalle"
                                   asp-route-id="@item.Mascota.IdMascota"
                                   class="btn btn-sm btn-florecitas me-1">Ver</a>

                                <a asp-page="./Editar"
                                   asp-route-id="@item.Mascota.IdMascota"
                                   class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-page="./Eliminar"
                                   asp-route-id="@item.Mascota.IdMascota"
                                   class="btn btn-sm btn-outline-danger">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>