@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-4">
    <section class="hero">
        <div class="hero-texto">
            <h1>Centro Veterinario  Florecitas</h1>
            <p>Panel principal del sistema.</p>
            <div class="hero-acciones">
                <a asp-page="/Clientes/Nuevo" class="btn btn-primary">Registrar cliente</a>
                <a asp-page="/Mascotas/Index" class="btn btn-success">Ver mascotas</a>
            </div>
        </div>
        <div class="hero-logo">
            <img src="~/imagenes/logo.png" alt="logo" />
        </div>
    </section>

    <div class="modulos">
        <a asp-page="/Clientes/Index" class="mod">
            <span class="mod-icono"><svg class="icono" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6" /><path d="M16 4.5a3.5 3.5 0 010 7M18 14.5c2 .7 3.5 2.6 3.5 5.5" /></svg></span>
            <h2>Clientes</h2>
            <p>Administración de propietarios.</p>
        </a>

        <a asp-page="/Mascotas/Index" class="mod">
            <span class="mod-icono"><svg class="icono" viewBox="0 0 24 24"><circle cx="6" cy="10" r="2" /><circle cx="10" cy="5.5" r="2" /><circle cx="15" cy="5.5" r="2" /><circle cx="19" cy="10" r="2" /><path d="M12.5 12c-3 0-5.5 3-5.5 5.2 0 1.6 1.4 2.3 2.8 2.3 1 0 1.8-.5 2.7-.5s1.7.5 2.7.5c1.4 0 2.8-.7 2.8-2.3 0-2.2-2.5-5.2-5.5-5.2z" /></svg></span>
            <h2>Mascotas</h2>
            <p>Registro de mascotas.</p>
        </a>

        <a asp-page="/Veterinarios/Index" class="mod mod--pronto">
            <span class="mod-icono"><svg class="icono" viewBox="0 0 24 24"><path d="M5 3v5a4 4 0 008 0V3" /><path d="M9 12v3a5 5 0 0010 0v-1.5" /><circle cx="19" cy="12" r="2" /></svg></span>
            <h2>Veterinarios</h2>
            <small>En preparación</small>
        </a>

        <a asp-page="/Consultas/Index" class="mod mod--pronto">
            <span class="mod-icono"><svg class="icono" viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 4h6v3H9zM9 12h6M9 16h4" /></svg></span>
            <h2>Consultas</h2>
            <small>En preparación</small>
        </a>

        <a asp-page="/Recetas/Index" class="mod mod--pronto">
            <span class="mod-icono"><svg class="icono" viewBox="0 0 24 24"><rect x="2.5" y="8.5" width="19" height="7" rx="3.5" transform="rotate(-45 12 12)" /><path d="M8.5 8.5l7 7" /></svg></span>
            <h2>Recetas</h2>
            <small>En preparación</small>
        </a>
    </div>
</div>
