@{
    var pagina = ViewContext.RouteData.Values["page"] as string ?? "";
    Func<string, string> activo = seccion =>
        pagina.StartsWith(seccion, StringComparison.OrdinalIgnoreCase) ? "activo" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Centro Veterinario</title>
    <link rel="icon" href="~/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/veterinaria.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Veterinaria.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app">
        <aside class="lateral" id="menuLateral">
            <a class="marca" asp-page="/Index">
                <span class="marca-logo">
                    <img src="~/images/logo.png" alt="Logo" />
                </span>
                <span class="marca-nombre">Centro Veterinario<small>Sistema de gestión</small></span>
            </a>

            <nav class="menu" aria-label="Principal">
                <a class="@activo("/Index")" asp-page="/Index">
                    <svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8" /><path d="M5 10v10h14V10" /></svg>Inicio
                </a>
                <a class="@activo("/Clientes")" asp-page="/Clientes/Index">
                    <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6" /><path d="M16 4.5a3.5 3.5 0 010 7M18 14.5c2 .7 3.5 2.6 3.5 5.5" /></svg>Clientes
                </a>
                <a class="@activo("/Mascotas")" asp-page="/Mascotas/Index">
                    <svg viewBox="0 0 24 24"><circle cx="6" cy="10" r="2" /><circle cx="10" cy="5.5" r="2" /><circle cx="15" cy="5.5" r="2" /><circle cx="19" cy="10" r="2" /><path d="M12.5 12c-3 0-5.5 3-5.5 5.2 0 1.6 1.4 2.3 2.8 2.3 1 0 1.8-.5 2.7-.5s1.7.5 2.7.5c1.4 0 2.8-.7 2.8-2.3 0-2.2-2.5-5.2-5.5-5.2z" /></svg>Mascotas
                </a>

                <p class="menu-sub">En preparación</p>
                <a class="tenue @activo("/Veterinarios")" asp-page="/Veterinarios/Index">
                    <svg viewBox="0 0 24 24"><path d="M5 3v5a4 4 0 008 0V3" /><path d="M9 12v3a5 5 0 0010 0v-1.5" /><circle cx="19" cy="12" r="2" /></svg>Veterinarios
                </a>
                <a class="tenue @activo("/Consultas")" asp-page="/Consultas/Index">
                    <svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 4h6v3H9zM9 12h6M9 16h4" /></svg>Consultas
                </a>
                <a class="tenue @activo("/Recetas")" asp-page="/Recetas/Index">
                    <svg viewBox="0 0 24 24"><rect x="2.5" y="8.5" width="19" height="7" rx="3.5" transform="rotate(-45 12 12)" /><path d="M8.5 8.5l7 7" /></svg>Recetas
                </a>
            </nav>
        </aside>

        <div class="principal">
            <header class="barra-movil">
                <button type="button" data-menu aria-label="Abrir menú">
                    <svg class="icono" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                </button>
                <strong>Centro Veterinario</strong>
            </header>

            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
            document.querySelectorAll('[data-menu]').forEach(function(b) {
                b.addEventListener('click', function() {
                    document.querySelector('.app').classList.toggle('abierto');
                });
            });
            document.querySelector('.app').addEventListener('click', function(e) {
                if (e.target === this) this.classList.remove('abierto');
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>